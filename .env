# API base URL for the Vue app
# Development uses the API backend on port 8888 via Vite proxy.
VITE_PROXY_TARGET_DEV=http://localhost:8888
# Production uses the same host/HTTPS as the frontend, so keep URLs relative.
VITE_API_BASE_URL=/mobilecmsapi/v50
VITE_MEDIA_BASE_URL=/media
VITE_ASSET_BASE_URL=/assets
